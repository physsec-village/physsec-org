# Deployment settings (COMPOSE_PROJECT_NAME, PSV_IMAGE, PSV_BLUE_PORT,
# PSV_GREEN_PORT, PSV_UPSTREAM_FILE) are appended to each host checkout's .env
# by the physsec-oci Ansible website role; leave them out of this file.

# Email configuration
APP_ENV=development
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
RECEIVER_EMAIL=

# Cloudflare Turnstile (contact form)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Dev uses dev.physsec.org, which must also be allowed in the Turnstile widget.
TURNSTILE_ALLOWED_HOSTNAMES=physsec.org,www.physsec.org

# Store PostgreSQL and Stripe Checkout
# Keep disabled until the database migration and deployment settings are ready.
# Dev deploys arbitrary branches and runs their migrations, so its URLs must
# use the separate psv_store_dev database (store_dev_app / psv_store_dev_owner),
# never psv_store. With the store enabled on dev, use Stripe test-mode keys.
STORE_ENABLED=false
# Passwords and POSTGRES_PRIVATE_IP come from the physsec-oci Ansible vault and
# Terraform output `postgres_private_ip`.
DATABASE_URL=postgresql://store_app:[STORE_APP_PASSWORD]@[POSTGRES_PRIVATE_IP]:5432/psv_store?sslmode=require
# Leave empty to skip migrations during deploy.
MIGRATION_DATABASE_URL=postgresql://psv_store_owner:[STORE_OWNER_PASSWORD]@[POSTGRES_PRIVATE_IP]:5432/psv_store?sslmode=require
STORE_MEDIA_DIR=data/media
# Dev uses https://dev.physsec.org.
STORE_PUBLIC_ORIGIN=https://physsec.org
STORE_SHIP_COUNTRIES=US,CA
STORE_AUTOMATIC_TAX=false
# Stripe requires at least 30 minutes; 35 leaves time for the API request.
STORE_RESERVATION_MINUTES=35
# Fresh catalogs fail closed unless initial stock is explicitly configured.
STORE_BOOTSTRAP_STOCK=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SHIPPING_RATE_IDS=
