# Email configuration
MAIL_USERNAME=
MAIL_PASSWORD=
RECEIVER_EMAIL=

# Stripe Checkout for /store
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional comma-separated Stripe shipping rate IDs, e.g. shr_123,shr_456
STRIPE_SHIPPING_RATE_IDS=
# Comma-separated ISO country codes accepted by Stripe Checkout shipping.
STORE_SHIP_COUNTRIES=US,CA
# Set to true to enable Stripe automatic tax calculation at checkout.
# Requires Stripe Tax to be enabled on the Stripe account first.
STORE_AUTOMATIC_TAX=
# Development seed data. Set to true locally to seed mock products; leave
# false/unset in production so an empty volume does not silently publish them.
STORE_SEED_MOCK_DATA=false
# Public origin used for Stripe redirect URLs (e.g. https://physsec.org).
# Falls back to the request host when unset; set it in production so redirect
# URLs cannot be influenced by a spoofed Host header.
STORE_PUBLIC_ORIGIN=
# DANGER: when true, /admin/store has no authentication and is only suitable
# for local development. Do not expose this in production.
ADMIN_UNPROTECTED=
