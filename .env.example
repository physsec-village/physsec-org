# Per-checkout deployment settings (see deploy/README.md). Production uses the
# defaults below; the dev checkout at /opt/psv-website-dev sets
# COMPOSE_PROJECT_NAME=psv-website-dev, PSV_IMAGE=psv-website-dev,
# PSV_BLUE_PORT=8081, PSV_GREEN_PORT=8083 and
# PSV_UPSTREAM_FILE=/etc/nginx/psv-upstreams/dev.conf so both stacks coexist.
#COMPOSE_PROJECT_NAME=psv-website
#PSV_IMAGE=psv-website
#PSV_BLUE_PORT=8080
#PSV_GREEN_PORT=8082
# nginx include that deploy/deploy.sh rewrites to switch colours. Required on
# deployment hosts; the deploy account must own the file.
#PSV_UPSTREAM_FILE=/etc/nginx/psv-upstreams/production.conf

# Email configuration
APP_ENV=development
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
RECEIVER_EMAIL=

# Cloudflare Turnstile (contact form)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# The dev checkout also needs dev.physsec.org in the Cloudflare widget allowlist.
TURNSTILE_ALLOWED_HOSTNAMES=physsec.org,www.physsec.org

# Supabase Postgres and Stripe Checkout
# Keep disabled until the database migration and deployment settings are ready.
# If STORE_ENABLED is ever true on dev, DATABASE_URL must point at a separate
# non-production database.
STORE_ENABLED=false
# Use the direct or session-pooler URL from the Supabase Connect dialog.
DATABASE_URL=postgresql://store_app:[YOUR-PASSWORD]@db.xrszuoznhlnnvktdjzdy.supabase.co:5432/postgres?sslmode=require
STORE_MEDIA_DIR=data/media
# The dev checkout uses https://dev.physsec.org.
STORE_PUBLIC_ORIGIN=https://physsec.org
STORE_SHIP_COUNTRIES=US,CA
STORE_AUTOMATIC_TAX=false
# Stripe requires at least 30 minutes; 35 leaves time for the API request.
STORE_RESERVATION_MINUTES=35
# Fresh catalogs fail closed unless initial stock is explicitly configured.
STORE_BOOTSTRAP_STOCK=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SHIPPING_RATE_IDS=
