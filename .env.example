# Email configuration
APP_ENV=development
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
RECEIVER_EMAIL=

# Cloudflare Turnstile (contact form)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=physsec.org,www.physsec.org

# Store database and Stripe Checkout
STORE_DB_PATH=data/store.db
STORE_PUBLIC_ORIGIN=https://physsec.org
STORE_SHIP_COUNTRIES=US,CA
STORE_AUTOMATIC_TAX=false
STORE_RESERVATION_MINUTES=30
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SHIPPING_RATE_IDS=
