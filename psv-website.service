[Unit]
Description=PSV Website (Docker Compose)
Requires=docker.service
Wants=nginx.service
After=docker.service nginx.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/systemctl is-active --quiet nginx.service
User=psv-deploy
Group=psv-deploy
WorkingDirectory=/opt/psv-website
# Boot and deploy both go through the serialized, health-gated blue/green
# script. Host nginx keeps serving while the inactive application slot builds.
ExecStart=/opt/psv-website/deploy/deploy.sh
ExecReload=/opt/psv-website/deploy/deploy.sh
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
