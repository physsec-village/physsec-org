[Unit]
Description=PSV Website (Docker Compose)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/psv-website
# Boot and deploy both go through the serialized, health-gated blue/green
# script. The router remains up while the inactive application slot is built.
ExecStart=/opt/psv-website/deploy/deploy.sh
ExecReload=/opt/psv-website/deploy/deploy.sh
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
