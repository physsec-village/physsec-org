# Copy to .env.dev only in the dedicated dev checkout on the VPS.
# Never commit the populated file or reuse production credentials.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
RECEIVER_EMAIL=

# APP_ENV is forced to production by docker-compose.dev.yml so all production
# safety checks remain active. Cloudflare's published test keys are suitable
# when this environment should not perform real Turnstile challenges.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=dev.physsec.org

STORE_ENABLED=false
DATABASE_URL=
STORE_MEDIA_DIR=data/media
STORE_PUBLIC_ORIGIN=https://dev.physsec.org
STORE_SHIP_COUNTRIES=US,CA
STORE_AUTOMATIC_TAX=false
STORE_RESERVATION_MINUTES=35
STORE_BOOTSTRAP_STOCK=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SHIPPING_RATE_IDS=
